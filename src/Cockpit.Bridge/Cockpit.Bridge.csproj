<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>cockpit-mcp-bridge</AssemblyName>
    <RootNamespace>Cockpit.Bridge</RootNamespace>
    <!-- Spawned once per CLI session: keep startup fast and the binary small. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Ship: `dotnet publish -c Release -r win-x64` gives a Native AOT exe that starts in tens of ms.
         Publish -r linux-x64 for the copy that runs inside WSL. AOT needs the platform C++ toolchain and the ILCompiler
         NuGet package, so offline builds (CockpitUseShims=true) publish the bridge as a normal .NET app. -->
    <PublishAot Condition="'$(CockpitUseShims)' != 'true'">true</PublishAot>
    <IsAotCompatible Condition="'$(CockpitUseShims)' != 'true'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Cockpit.Protocol/Cockpit.Protocol.csproj" />
  </ItemGroup>
</Project>
