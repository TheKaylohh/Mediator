<Window x:Class="Mediator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mediator.UI;assembly=Mediator.UI"
        xmlns:controls="clr-namespace:Mediator.Wpf.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MediatorOverlayViewModel}"
        Title="Mediator"
        Width="452" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowDrop="True"
        FontFamily="{DynamicResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBrush}">

  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
  </Window.InputBindings>

  <!-- Margin leaves room for the glow / drop shadow. -->
  <Border Margin="12" CornerRadius="{DynamicResource WindowCornerRadius}" Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource HudFrameBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource GlowColor}" />
    </Border.Effect>

    <Grid>
      <DockPanel LastChildFill="True">

        <!-- ── Header: orb, name and state, subscription pills, theme, hide ── -->
        <Grid DockPanel.Dock="Top" Margin="10,10,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:HudOrbControl State="{Binding ReactorState}" ToolTip="{Binding ReactorDetail}" Cursor="Hand" VerticalAlignment="Center">
            <controls:HudOrbControl.InputBindings>
              <MouseBinding Gesture="LeftClick" Command="{Binding AcknowledgeFaultCommand}" />
            </controls:HudOrbControl.InputBindings>
          </controls:HudOrbControl>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="MEDIATOR" FontFamily="{DynamicResource HeaderFont}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{Binding ReactorCaption}" ToolTip="{Binding ReactorDetail}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TechLabel}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ReactorState}" Value="Active">
                      <Setter Property="Foreground" Value="{DynamicResource OrbActiveBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ReactorState}" Value="AwaitingApproval">
                      <Setter Property="Foreground" Value="{DynamicResource OrbApprovalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ReactorState}" Value="Error">
                      <Setter Property="Foreground" Value="{DynamicResource OrbErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <ItemsControl Grid.Column="2" ItemsSource="{Binding Providers}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="9" Padding="7,2" Margin="4,0,0,0" Background="{DynamicResource PanelBrush}" BorderThickness="1" ToolTip="{Binding Status}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="Transparent" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCoolingDown}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
            <ToggleButton IsChecked="{Binding IsPinned}" Cursor="Hand" Padding="6,4" Background="Transparent" BorderThickness="0"
                          ToolTip="Keep the panel open while you drag files in from Explorer" AutomationProperties.Name="Pin open">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource CardCornerRadius}" Padding="6,4">
                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="12" Text="&#xE718;" Foreground="{DynamicResource MutedBrush}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Glyph" Property="Text" Value="&#xE840;" />
                      <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <!-- V10: routing policy pill (Auto Best / Quota Saver (Antigravity) / Claude First) -->
            <Button Style="{StaticResource FlatButton}" Padding="8,3" Margin="0,0,2,0" Command="{Binding CycleRoutingPolicyCommand}"
                    ToolTip="Which subscription goes first when you do not pick one (click to change)" AutomationProperties.Name="Routing policy">
              <TextBlock Text="{Binding RoutingPolicyText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
            </Button>
            <!-- V18: light / dark mode (the same toggle as in the full-screen app); the classic themes are in the setup card. -->
            <Button Style="{StaticResource FlatButton}" Padding="6,4" Command="{Binding ToggleLightDarkCommand}"
                    ToolTip="{Binding LightDarkText}" AutomationProperties.Name="Light or dark mode">
              <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="{Binding LightDarkGlyph}" />
            </Button>
          </StackPanel>
          <Button Grid.Column="4" Style="{StaticResource FlatButton}" Padding="6,4" Margin="2,0,0,0" ToolTip="Hide (Esc)" Command="{Binding HideCommand}"
                  AutomationProperties.Name="Hide">
            <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE711;" />
          </Button>
        </Grid>

        <!-- ── Footer: status, terminal mode, kill switch ── -->
        <Grid DockPanel.Dock="Bottom" Margin="14,6,14,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" VerticalAlignment="Center" />
          <CheckBox Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" FontSize="12"
                    IsChecked="{Binding KeepSubscription}" Content="Keep sub."
                    ToolTip="Never switch subscriptions: if the routed one is at its limit, refuse instead of failing over" />
          <CheckBox Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                    IsChecked="{Binding UseTerminal}" Content="Terminal"
                    ToolTip="Run jobs as an interactive Claude Code terminal (billing-safe fallback) instead of headless" />
          <CheckBox Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                    IsChecked="{Binding AutoApproveAll}" Content="Auto-approve"
                    ToolTip="Approve every tool request without asking (until the app restarts). Each one is still logged in the chat." />
          <Button Grid.Column="4" Style="{StaticResource DangerButton}" Padding="12,5" Command="{Binding KillAllCommand}"
                  ToolTip="Kill switch: end every running job now (grants revoked, processes terminated)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE71A;" Margin="0,0,6,0" />
              <TextBlock Text="Kill all" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- ── Billing banner ── -->
        <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="10,6" CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                Visibility="{Binding HasBillingBanner, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="4,2" Command="{Binding DismissBannerCommand}">
              <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE711;" />
            </Button>
            <TextBlock Text="{Binding BillingBanner}" TextWrapping="Wrap" FontSize="12" />
          </DockPanel>
        </Border>

        <!-- ── Prompt, with [ + Attach ] beside it ── -->
        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
              <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="10,0,4,0" Text="&#xE721;" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="PromptBox" Grid.Column="1" Padding="4,8" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" SelectionBrush="{DynamicResource SelectionBrush}" FontSize="14"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                         Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter to send · Shift+Enter for a new line · Up for your last prompt · Esc to stop" />
                <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14"
                           Foreground="{DynamicResource MutedBrush}" Text="Ask anything, / to search, Ctrl+V to paste a screenshot"
                           Visibility="{Binding PromptText, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                <!-- Sweep along the bottom edge while a job is active (oscillates; stops when the state changes). -->
                <Rectangle Grid.ColumnSpan="2" Height="2" Width="110" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                           IsHitTestVisible="False" Fill="{DynamicResource SweepBrush}">
                  <Rectangle.RenderTransform>
                    <TranslateTransform X="-110" />
                  </Rectangle.RenderTransform>
                  <Rectangle.Style>
                    <Style TargetType="Rectangle">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ReactorState}" Value="Active">
                          <Setter Property="Visibility" Value="Visible" />
                          <DataTrigger.EnterActions>
                            <BeginStoryboard Name="SweepStoryboard">
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-110" To="400" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever" />
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="SweepStoryboard" />
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Rectangle.Style>
                </Rectangle>
              </Grid>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Padding="9,0" Command="{Binding AttachCommand}"
                    ToolTip="Attach files, folders or images (or drop them on the panel, or Ctrl+V a screenshot). Jobs can read them, never change them."
                    AutomationProperties.Name="Attach">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE723;" Margin="0,0,5,0" />
                <TextBlock Text="Attach" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Padding="9,0" Command="{Binding ChooseSaveFolderCommand}"
                    ToolTip="Choose the folder jobs save into (a Windows folder picker). Stays until you clear it."
                    AutomationProperties.Name="Save to">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE74E;" Margin="0,0,5,0" />
                <TextBlock Text="Save to" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <DockPanel Margin="0,6,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Padding="10,3" Margin="6,0,0,0" Command="{Binding StopCommand}"
                    Visibility="{Binding IsChatBusy, Converter={StaticResource BoolToVisibility}}" ToolTip="Stop the running prompt" AutomationProperties.Name="Stop">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE71A;" Margin="0,0,5,0" />
                <TextBlock Text="Stop" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <ComboBox DockPanel.Dock="Left" MinWidth="190" Margin="0,0,6,0" FontSize="12" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}"
                      DisplayMemberPath="Label" ToolTip="Model: Auto lets the routing rules pick; any other entry runs on that CLI and model" AutomationProperties.Name="Model" />
            <ComboBox DockPanel.Dock="Left" MinWidth="70" Margin="0,0,6,0" FontSize="12" ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding SelectedEffort}"
                      ToolTip="Reasoning effort (--effort). Auto: the CLI's default" AutomationProperties.Name="Effort" />
          </DockPanel>
          <DockPanel Margin="4,4,0,0" Visibility="{Binding HasSaveFolder, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="4,0" Command="{Binding ClearSaveFolderCommand}"
                    ToolTip="Clear: jobs use the folder selected in Explorer again" AutomationProperties.Name="Clear save folder">
              <TextBlock Style="{StaticResource Icon}" FontSize="8" Text="&#xE711;" />
            </Button>
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding SaveFolderText}" ToolTip="{Binding SaveFolder}" />
          </DockPanel>
          <Border Margin="0,6,0,0" Padding="8,5" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                  Visibility="{Binding HasFolderRequest, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,2" Margin="4,0,0,0" Command="{Binding DismissFolderRequestCommand}"
                      Content="Dismiss" FontSize="12" AutomationProperties.Name="Dismiss folder request" />
              <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="8,2" Command="{Binding AllowFolderRequestCommand}"
                      ToolTip="Let this chat's jobs read and write this folder (the running job gets it now)" AutomationProperties.Name="Allow folder">
                <TextBlock Text="Allow" FontSize="12" />
              </Button>
              <TextBlock Text="{Binding FolderRequestText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
            </DockPanel>
          </Border>
          <TextBlock Style="{StaticResource MutedText}" Margin="4,4,0,0" Text="{Binding SuggestionText}"
                     Visibility="{Binding SuggestionText, Converter={StaticResource EmptyToCollapsed}}" />
          <TextBlock Margin="4,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="{Binding RouteText}"
                     Visibility="{Binding RouteText, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>

        <!-- ── V9: continue the last Claude session (claude -p resume). Selected = the next prompt is a follow-up;
             click to start fresh this time; × removes it. Switching folders removes it too. ── -->
        <ToggleButton DockPanel.Dock="Top" Margin="12,4,12,0" HorizontalAlignment="Left" Style="{StaticResource ChipToggle}"
                      DataContext="{Binding Continuation}" IsChecked="{Binding IsSelected}" ToolTip="{Binding ToolTipText}"
                      Visibility="{Binding DataContext.HasContinuation, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="Continue session">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Text}" FontSize="12" />
            <Button Style="{StaticResource FlatButton}" Padding="3,0" Margin="6,0,-4,0" ToolTip="Start fresh (remove the follow-up)"
                    Command="{Binding DataContext.ClearContinuationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Remove continue session">
              <TextBlock Style="{StaticResource Icon}" FontSize="8" Text="&#xE711;" />
            </Button>
          </StackPanel>
        </ToggleButton>

        <!-- ── Context chips: Explorer context (toggle) and attachments (× removes) ── -->
        <ItemsControl DockPanel.Dock="Top" Margin="12,4,12,2" ItemsSource="{Binding ContextChips}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding IsIncluded}" ToolTip="{Binding ToolTipText}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0" Text="{Binding KindGlyph}" />
                  <TextBlock Text="{Binding Label}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="5,0,0,0" Text="&#xE8CB;" Foreground="{DynamicResource AccentBrush}"
                             ToolTip="Also shared with the running job"
                             Visibility="{Binding SharedWith, Converter={StaticResource EmptyToCollapsed}}" />
                  <Button Style="{StaticResource FlatButton}" Padding="3,0" Margin="4,0,-4,0" Command="{Binding RemoveCommand}"
                          ToolTip="Remove" AutomationProperties.Name="Remove attachment"
                          Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Icon}" FontSize="8" Text="&#xE711;" />
                  </Button>
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── Body: tabs; the first-run card and the approval card cover them while open ── -->
        <Grid Margin="4,4,4,0" MinHeight="280">

          <TabControl SelectedIndex="{Binding SelectedTab}"
                      Visibility="{Binding HasPendingApproval, Converter={StaticResource InverseBoolToVisibility}}">

            <!-- Actions -->
            <TabItem Header="Actions">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <StackPanel>
                <!-- V10: the conversation. Each headless run: prompt, CLI · model, steps, and the full answer (selectable). -->
                <StackPanel Margin="8,6,8,0" Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl ItemsSource="{Binding Conversation}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource PanelBrush}" Padding="10,8" Margin="0,0,0,6">
                          <StackPanel>
                            <TextBlock Text="{Binding UserPrompt}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="{Binding BadgeText}" />
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding ThinkingSummary}"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Margin="0,4,0,0" Text="{Binding ResponseText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                     MaxHeight="300" VerticalScrollBarVisibility="Auto" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" Padding="8,2" Command="{Binding OpenFullViewCommand}" AutomationProperties.Name="Open full view">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE740;" Margin="0,0,5,0" />
                        <TextBlock Text="Full view" FontSize="12" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="8,2" Command="{Binding ClearConversationCommand}"
                            AutomationProperties.Name="Clear conversation">
                      <TextBlock Text="Clear conversation" FontSize="12" />
                    </Button>
                  </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding FilteredActions}" Margin="8,6,8,6" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Row" CornerRadius="{DynamicResource CardCornerRadius}" Padding="10,8" Margin="0,0,0,2" Background="Transparent">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="28" Height="28" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" HorizontalAlignment="Center" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="4,0,8,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Provider}" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource TechFont}" FontSize="11.5" Margin="0,2,0,0"
                                       ToolTip="{Binding ToolsText}" />
                            <TextBlock Text="{Binding DisabledReason}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5" TextWrapping="Wrap"
                                       Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FlatButton}" Padding="6,4" Margin="0,0,4,0" ToolTip="Delete this action"
                                    Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Delete action">
                              <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE74D;" />
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Content="Run"
                                    Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding IsEnabled}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelBrush}" />
                        </Trigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- User-made actions: a name and instructions; the prompt is the input when it runs. -->
                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="12,0,0,8" Padding="8,4" Command="{Binding NewActionCommand}"
                        AutomationProperties.Name="New action">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE710;" Margin="0,0,6,0" />
                    <TextBlock Text="New action" FontSize="12" />
                  </StackPanel>
                </Button>
                <Border Style="{StaticResource Card}" Margin="8,0,8,8" Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="Name" />
                    <TextBox Margin="0,2,0,6" Text="{Binding NewActionTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="Short description (optional)" />
                    <TextBox Margin="0,2,0,6" Text="{Binding NewActionDescription, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="Instructions (what the AI should do; your prompt is added when it runs)" TextWrapping="Wrap" />
                    <TextBox Margin="0,2,0,6" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding NewActionInstructions, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Needs a folder (selected in Explorer or named in the prompt)" FontSize="12" IsChecked="{Binding NewActionNeedsFolder}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                      <Button Style="{StaticResource FlatButton}" Padding="10,4" Margin="0,0,6,0" Content="Cancel" Command="{Binding NewActionCommand}" />
                      <Button Style="{StaticResource AccentButton}" Content="Save action" Command="{Binding SaveActionCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- Jobs -->
            <TabItem Header="{Binding JobsTabHeader}">
              <Grid>
                <TextBlock Style="{StaticResource MutedText}" Margin="16" Text="No jobs yet. Run an action or type a prompt."
                           Visibility="{Binding Jobs.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                  <ItemsControl ItemsSource="{Binding Jobs}" Margin="8,6,8,6" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top"
                                     Fill="{Binding State, Converter={StaticResource JobStateBrush}}" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StateText}" />
                                <TextBlock Style="{StaticResource MutedText}" Text="  ·  " />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Provider}" />
                                <TextBlock Style="{StaticResource MutedText}" Text="  ·  " />
                                <TextBlock Style="{StaticResource MutedText}" FontFamily="{DynamicResource TechFont}" Text="{Binding ElapsedText}" />
                                <TextBlock Style="{StaticResource MutedText}" Text="  ·  " />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Launch}" />
                              </StackPanel>
                              <TextBlock Style="{StaticResource MutedText}" Text="{Binding OutcomeText}"
                                         Visibility="{Binding OutcomeText, Converter={StaticResource EmptyToCollapsed}}" />
                              <TextBlock Style="{StaticResource MutedText}" Text="{Binding RoutingText}" TextWrapping="Wrap" MaxHeight="48" Foreground="{DynamicResource WarningBrush}"
                                         Visibility="{Binding RoutingText, Converter={StaticResource EmptyToCollapsed}}" />
                              <TextBlock Style="{StaticResource MutedText}" Text="{Binding Detail}" TextWrapping="Wrap" MaxHeight="48"
                                         Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                              <TextBlock Style="{StaticResource TechLabel}" FontSize="11" Text="{Binding JobId}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Style="{StaticResource FlatButton}" Padding="6,4" Margin="0,0,4,0" ToolTip="Open full view"
                                      Command="{Binding DataContext.OpenFullViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      AutomationProperties.Name="Open full view">
                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE740;" />
                              </Button>
                              <Button Style="{StaticResource OutlineButton}" Command="{Binding KillCommand}"
                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" ToolTip="Kill this job">
                                <TextBlock Text="Kill" Foreground="{DynamicResource DangerBrush}" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </TabItem>

            <!-- Activity -->
            <TabItem Header="Activity">
              <ListBox ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0" Margin="6" MaxHeight="420"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource TechLabel}" Text="{Binding TimeText}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock TextTrimming="CharacterEllipsis" FontSize="12">
                          <Run Text="{Binding Tool, Mode=OneWay}" FontWeight="SemiBold" />
                          <Run Text="{Binding Phase, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" MaxHeight="44"
                                   Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>

            <!-- Connectors (V15): every connector the Mediator offers, live or not, by category. Each row shows the app's icon,
                 its name, one line and a status; the chevron opens the details. -->
            <TabItem Header="Connectors">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" DataContext="{Binding Connectors}">
                <StackPanel Margin="10,2,10,8">
                  <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,3" Command="{Binding RefreshCommand}" ToolTip="Check again">
                      <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE72C;" />
                    </Button>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="{Binding LiveSummary}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Text="Connection center" />
                  </DockPanel>

                  <TextBlock Style="{StaticResource SectionTitle}" Text="SUBSCRIPTION CLIS" />
                  <ItemsControl ItemsSource="{Binding Clis}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{Binding Glyph}" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconPath, Converter={StaticResource FileIconMissing}}" />
                                <Image Width="24" Height="24" Source="{Binding IconPath, Converter={StaticResource FileIcon}}" />
                              </Grid>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Text="{Binding Subscription}" />
                              </StackPanel>
                              <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0" CornerRadius="9" Padding="8,1" BorderThickness="1"
                                      BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBrush}}">
                                <TextBlock FontSize="12" Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                              </Border>
                              <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="5,3" VerticalAlignment="Center" Command="{Binding ToggleCommand}" ToolTip="Details">
                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE70D;" />
                              </Button>
                            </Grid>
                            <StackPanel Margin="34,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock FontSize="12" FontFamily="{DynamicResource TechFont}" Foreground="{DynamicResource MutedBrush}" Text="{Binding VersionText}" />
                              <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding AuthText}" Foreground="{DynamicResource TextBrush}" />
                              <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding CooldownText}" Foreground="{DynamicResource WarningBrush}"
                                         Visibility="{Binding HasCooldown, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Margin="34,6,0,0" Style="{StaticResource OutlineButton}" Padding="8,2" Content="Sign In" Command="{Binding SignInCommand}"
                                    Visibility="{Binding IsSignedInLikely, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTip="Opens a terminal with the CLI (API-key variables removed) so you sign in with your subscription" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Style="{StaticResource SectionTitle}" Text="DESKTOP APPS" />
                  <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{Binding Glyph}" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconPath, Converter={StaticResource FileIconMissing}}" />
                                <Image Width="24" Height="24" Source="{Binding IconPath, Converter={StaticResource FileIcon}}" />
                              </Grid>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                              </StackPanel>
                              <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0" CornerRadius="9" Padding="8,1" BorderThickness="1"
                                      BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBrush}}">
                                <TextBlock FontSize="12" Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                              </Border>
                              <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="5,3" VerticalAlignment="Center" Command="{Binding ToggleCommand}" ToolTip="Details">
                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE70D;" />
                              </Button>
                            </Grid>
                            <StackPanel Margin="34,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding Detail}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Style="{StaticResource SectionTitle}" Text="CHROME EXTENSION" />
                  <Border Style="{StaticResource Card}" DataContext="{Binding Browser}">
                    <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{Binding Glyph}" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconPath, Converter={StaticResource FileIconMissing}}" />
                                <Image Width="24" Height="24" Source="{Binding IconPath, Converter={StaticResource FileIcon}}" />
                              </Grid>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Mediator for Chrome" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Text="Read and use your Chrome tabs; chat in the side panel" />
                              </StackPanel>
                              <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0" CornerRadius="9" Padding="8,1" BorderThickness="1"
                                      BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBrush}}">
                                <TextBlock FontSize="12" Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                              </Border>
                              <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="5,3" VerticalAlignment="Center" Command="{Binding ToggleCommand}" ToolTip="Details">
                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE70D;" />
                              </Button>
                            </Grid>
                            <StackPanel Margin="34,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding Detail}" />
                              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource OutlineButton}" Padding="8,2" Command="{Binding SetUpCommand}"
                                        ToolTip="Prepares the extension folder and copies its path: in chrome://extensions turn on Developer mode, Load unpacked, paste">
                                  <TextBlock Text="{Binding SetUpText}" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource OutlineButton}" Padding="8,2" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}"
                                        ToolTip="Opens the folder Chrome loads the extension from">
                                  <TextBlock Text="Folder" FontSize="12" />
                                </Button>
                              </StackPanel>
                            </StackPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock Style="{StaticResource SectionTitle}" Text="FILE FORMATS (BUILT IN)" />
                  <ItemsControl ItemsSource="{Binding Formats}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{Binding Glyph}" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconPath, Converter={StaticResource FileIconMissing}}" />
                                <Image Width="24" Height="24" Source="{Binding IconPath, Converter={StaticResource FileIcon}}" />
                              </Grid>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                              </StackPanel>
                              <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0" CornerRadius="9" Padding="8,1" BorderThickness="1"
                                      BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBrush}}">
                                <TextBlock FontSize="12" Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                              </Border>
                              <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="5,3" VerticalAlignment="Center" Command="{Binding ToggleCommand}" ToolTip="Details">
                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE70D;" />
                              </Button>
                            </Grid>
                            <StackPanel Margin="34,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding Detail}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Padding="8,2" Margin="0,6,0,0" Command="{Binding ToggleAddCommand}">
                      <TextBlock Text="+ Add Custom MCP" FontSize="12" />
                    </Button>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="CUSTOM MCP SERVERS" />
                  </DockPanel>

                  <!-- Add form -->
                  <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentBrush}"
                          Visibility="{Binding IsAddOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource TechLabel}" Text="NAME (a-z, 0-9, -)" />
                      <TextBox Style="{StaticResource FieldBox}" Margin="0,2,0,6" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Style="{StaticResource TechLabel}" Text="COMMAND (npx, uvx, python or a full path)" />
                      <TextBox Style="{StaticResource FieldBox}" Margin="0,2,0,6" Text="{Binding NewCommand, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Style="{StaticResource TechLabel}" Text="ARGUMENTS (space-separated; quote ones with spaces)" />
                      <TextBox Style="{StaticResource FieldBox}" Margin="0,2,0,6" Text="{Binding NewArgs, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                 Text="The server is started for a 15 s health check (initialize + tools/list). Its tools run on your PC, so every call asks for your approval. No environment variables are stored." />
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Check and add" Command="{Binding AddServerCommand}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding AddStatus}" />
                      </DockPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock Style="{StaticResource MutedText}" Margin="2,0,0,4" Text="None yet."
                             Visibility="{Binding HasMcpServers, Converter={StaticResource InverseBoolToVisibility}}" />
                  <ItemsControl ItemsSource="{Binding McpServers}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{Binding Glyph}" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconPath, Converter={StaticResource FileIconMissing}}" />
                                <Image Width="24" Height="24" Source="{Binding IconPath, Converter={StaticResource FileIcon}}" />
                              </Grid>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource TechLabel}" TextTrimming="CharacterEllipsis" Text="{Binding CommandLine}" ToolTip="{Binding CommandLine}" />
                              </StackPanel>
                              <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0" CornerRadius="9" Padding="8,1" BorderThickness="1"
                                      BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBrush}}">
                                <TextBlock FontSize="12" Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                              </Border>
                              <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="5,3" VerticalAlignment="Center" Command="{Binding ToggleCommand}" ToolTip="Details">
                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE70D;" />
                              </Button>
                            </Grid>
                            <StackPanel Margin="34,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding HealthText}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxHeight="44" Text="{Binding ToolsText}"
                                         Visibility="{Binding ToolsText, Converter={StaticResource EmptyToCollapsed}}" />
                              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding IsEnabled}" Content="Enabled" ToolTip="Offer this server's tools to new jobs" />
                                <Button Style="{StaticResource OutlineButton}" Padding="8,2" Margin="0,0,6,0" Content="Check" Command="{Binding PingCommand}" />
                                <Button Style="{StaticResource FlatButton}" Padding="8,2" Command="{Binding RemoveCommand}">
                                  <TextBlock Text="Remove" Foreground="{DynamicResource DangerBrush}" FontSize="12" />
                                </Button>
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,4,0,0" Text="{Binding Status}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- Usage (V14): 5-hour and weekly use per subscription; reading it runs no model -->
            <TabItem Header="Usage">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" DataContext="{Binding Usage}">
                <StackPanel Margin="10,2,10,8">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,3" Command="{Binding RefreshCommand}" ToolTip="Check again (uses no tokens)">
                      <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE72C;" />
                    </Button>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="SUBSCRIPTION USAGE" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Subscriptions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}">
                          <StackPanel>
                            <DockPanel>
                              <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </DockPanel>
                            <StackPanel Margin="19,6,0,0" Visibility="{Binding HasMeter, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="{Binding FiveHourText}" />
                              <ProgressBar Height="6" Margin="0,3,0,8" Minimum="0" Maximum="100" Value="{Binding FiveHourPercent, Mode=OneWay}"
                                           Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}" BorderThickness="0" />
                              <TextBlock Text="{Binding WeekText}" />
                              <ProgressBar Height="6" Margin="0,3,0,4" Minimum="0" Maximum="100" Value="{Binding WeekPercent, Mode=OneWay}"
                                           Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}" BorderThickness="0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="19,4,0,0" Text="{Binding Note}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="19,2,0,0" Text="{Binding LocalText}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,4,0,0" Text="{Binding Status}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>

          <!-- ── First-run card ── -->
          <Border Margin="8,4,8,8" Padding="14,12" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" DataContext="{Binding Onboarding}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <!-- An approval always wins. -->
                  <DataTrigger Binding="{Binding DataContext.HasPendingApproval, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
              <StackPanel>
                <TextBlock Text="SET UP MEDIATOR" FontFamily="{DynamicResource HeaderFont}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="Jobs run on your Claude Pro and Google AI Pro subscriptions through their CLIs. One of the two is enough." />

                <ItemsControl ItemsSource="{Binding Prerequisites}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                              <Setter Property="Text" Value="&#xE916;" />
                              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                  <Setter Property="Text" Value="&#xE73E;" />
                                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOk}" Value="False">
                                  <Setter Property="Text" Value="&#xE7BA;" />
                                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1">
                          <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding Status, Mode=OneWay}" FontFamily="{DynamicResource TechFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                          </TextBlock>
                          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding Hint}"
                                     Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Summary}" />

                <TextBlock Style="{StaticResource SectionTitle}" Text="THEME" />
                <ItemsControl ItemsSource="{Binding ThemeOptions}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="0,0,6,6" Padding="10,4" Content="{Binding Name}" CommandParameter="{Binding}"
                              Command="{Binding DataContext.Onboarding.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SectionTitle}" Text="HOTKEY" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="{Binding HotkeyError}"
                           Visibility="{Binding HotkeyError, Converter={StaticResource EmptyToCollapsed}}" />
                <ItemsControl ItemsSource="{Binding HotkeyPresets}" Margin="0,6,0,0" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource FlatButton}" Margin="0,0,4,4" Padding="6,2" Content="{Binding}" CommandParameter="{Binding}"
                              FontFamily="{DynamicResource TechFont}" FontSize="12"
                              Command="{Binding DataContext.Onboarding.UsePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox Margin="0,8,0,0" IsChecked="{Binding RunOnStartup}" Content="Run Mediator when I sign in to Windows"
                          Foreground="{DynamicResource TextBrush}"
                          Visibility="{Binding IsStartupSupported, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                  <Button Style="{StaticResource FlatButton}" Content="Check again" Command="{Binding RecheckCommand}" Margin="0,0,6,0" />
                  <Button Style="{StaticResource OutlineButton}" Content="Later" Command="{Binding SkipCommand}" Margin="0,0,6,0" />
                  <Button Style="{StaticResource AccentButton}" Content="Finish" Command="{Binding FinishCommand}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- ── Approval card ── -->
          <Border Margin="8,4,8,8" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource PanelBrush}" BorderThickness="1"
                  DataContext="{Binding PendingApproval}"
                  Visibility="{Binding DataContext.HasPendingApproval, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                             Text="{Binding DataContext.QueuedApprovalsText, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock FontSize="12" FontFamily="{DynamicResource TechFont}" Foreground="{DynamicResource MutedBrush}">
                    <Run Text="APPROVAL NEEDED" />
                    <Run Text="·" />
                    <Run Text="{Binding Tool, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Risk, Mode=OneWay}" />
                  </TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,2" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           Visibility="{Binding Summary, Converter={StaticResource EmptyToCollapsed}}" />
                <TextBlock Style="{StaticResource TechLabel}" FontSize="11" Margin="0,2,0,6" Text="{Binding JobId}" />
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding SelectionText}" />
                <Button Style="{StaticResource FlatButton}" Command="{Binding KillJobCommand}" Margin="0,0,6,0" ToolTip="Deny and end the whole job">
                  <TextBlock Text="Kill job" Foreground="{DynamicResource DangerBrush}" />
                </Button>
                <Button Style="{StaticResource OutlineButton}" Content="Deny" Command="{Binding DenyCommand}" Margin="0,0,6,0" IsCancel="True" />
                <Button Style="{StaticResource OutlineButton}" Content="Approve all" Command="{Binding ApproveAllCommand}" Margin="0,0,6,0"
                        Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource AccentButton}" Content="Approve selected" Command="{Binding ApproveSelectedCommand}"
                        Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource AccentButton}" Content="Approve" Command="{Binding ApproveAllCommand}"
                        Visibility="{Binding IsSelectable, Converter={StaticResource InverseBoolToVisibility}}" />
              </StackPanel>

              <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                        CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single"
                        GridLinesVisibility="None" Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.ColumnHeaderStyle>
                  <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                  <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource LowConfidenceRowBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsChecked}" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Item" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Margin="2,3">
                          <TextBlock Text="{Binding Primary}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                     Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Conf." Width="44" Binding="{Binding ConfidenceText}" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </DockPanel>

      <!-- ── HUD decoration (Holo HUD theme only): corner brackets ── -->
      <Grid IsHitTestVisible="False" Visibility="{DynamicResource HudDecorVisibility}">
        <Path Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" StrokeThickness="1.5" Stroke="{DynamicResource AccentBrush}" Data="M0,14 L0,0 L14,0" />
        <Path Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top" StrokeThickness="1.5" Stroke="{DynamicResource AccentBrush}" Data="M0,0 L14,0 L14,14" />
        <Path Margin="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" StrokeThickness="1.5" Stroke="{DynamicResource Accent2Brush}" Data="M0,0 L0,14 L14,14" />
        <Path Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" StrokeThickness="1.5" Stroke="{DynamicResource Accent2Brush}" Data="M14,0 L14,14 L0,14" />
      </Grid>

      <!-- ── Scanlines (transparent in the other themes) ── -->
      <Rectangle IsHitTestVisible="False" Fill="{DynamicResource ScanlineBrush}" RadiusX="4" RadiusY="4" />

      <!-- ── Drop target, shown while files are dragged over the panel ── -->
      <Border CornerRadius="{DynamicResource WindowCornerRadius}" Background="{DynamicResource DropOverlayBrush}" IsHitTestVisible="False"
              Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVisibility}}">
        <Grid Margin="14">
          <Rectangle StrokeThickness="2" StrokeDashArray="6 4" RadiusX="6" RadiusY="6" Stroke="{DynamicResource AccentBrush}">
            <Rectangle.Effect>
              <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.9" Color="{DynamicResource AccentColor}" />
            </Rectangle.Effect>
          </Rectangle>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center" Text="&#xE896;" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Margin="0,10,0,4" HorizontalAlignment="Center" Text="DROP ARTIFACTS TO ATTACH" FontFamily="{DynamicResource HeaderFont}"
                       FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TechLabel}" Text="files are copied · folders are shared read-only" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
