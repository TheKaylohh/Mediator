<!-- Clean Light: high-clarity daylight theme. Slate type on white cards, royal blue accent.
     Every theme defines exactly the same keys (verify/tests XamlChecker enforces it); the window and styles use
     them through DynamicResource, so ThemeManager can swap this dictionary at run time. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <Color x:Key="BgColor">#FFF8FAFC</Color>
  <Color x:Key="PanelColor">#FFFFFFFF</Color>
  <Color x:Key="RaisedColor">#FFF1F5F9</Color>
  <Color x:Key="BorderColor">#FFE2E8F0</Color>
  <Color x:Key="TextColor">#FF0F172A</Color>
  <Color x:Key="MutedColor">#FF64748B</Color>
  <Color x:Key="AccentColor">#FF2563EB</Color>
  <Color x:Key="Accent2Color">#FF3B82F6</Color>
  <Color x:Key="DangerColor">#FFDC2626</Color>
  <Color x:Key="SuccessColor">#FF16A34A</Color>
  <Color x:Key="WarningColor">#FFD97706</Color>
  <Color x:Key="GlowColor">#FF0F172A</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#1ADC2626" />
  <SolidColorBrush x:Key="LowConfidenceRowBrush" Color="#1FD97706" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#332563EB" />
  <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FFF1F5F9" />
  <SolidColorBrush x:Key="DropOverlayBrush" Color="#EBF8FAFC" />

  <!-- The orb's four states. -->
  <SolidColorBrush x:Key="OrbIdleBrush" Color="#FF2563EB" />
  <SolidColorBrush x:Key="OrbActiveBrush" Color="#FF3B82F6" />
  <SolidColorBrush x:Key="OrbApprovalBrush" Color="#FFD97706" />
  <SolidColorBrush x:Key="OrbErrorBrush" Color="#FFDC2626" />

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="HudFrameBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ScanlineBrush" Color="Transparent" />
  <!-- The sweep that runs along the prompt's edge while a job is active. -->
  <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="Transparent" Offset="0" />
    <GradientStop Color="#992563EB" Offset="0.5" />
    <GradientStop Color="Transparent" Offset="1" />
  </LinearGradientBrush>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="HeaderFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TechFont">Cascadia Mono, Consolas</FontFamily>

  <CornerRadius x:Key="WindowCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <sys:Double x:Key="ShadowOpacity">0.18</sys:Double>
  <!-- Corner brackets and the reticle frame: shown by the HUD theme only. -->
  <Visibility x:Key="HudDecorVisibility">Collapsed</Visibility>
</ResourceDictionary>
