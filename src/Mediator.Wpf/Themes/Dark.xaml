<!-- Dark (V18 default): graphite surfaces, one indigo accent, a sky-blue activity colour.
     Every theme defines exactly the same keys (verify/tests XamlChecker enforces it); the windows and styles use them through
     DynamicResource, so ThemeManager swaps this dictionary at run time. Text colours meet WCAG AA (4.5:1) on the background,
     panel and raised surfaces. The V7-V17 themes are kept unchanged in Themes/Legacy. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Surfaces, from the window up: background, panels and sidebars, raised (hover, inputs, chips). -->
  <Color x:Key="BgColor">#FF141519</Color>
  <Color x:Key="PanelColor">#FF1B1C21</Color>
  <Color x:Key="RaisedColor">#FF24262D</Color>
  <Color x:Key="BorderColor">#FF2E3038</Color>
  <Color x:Key="TextColor">#FFE8E9ED</Color>
  <Color x:Key="MutedColor">#FF9497A3</Color>
  <!-- One accent for actions and focus; a second, cooler one for activity. Status colours are reserved for status. -->
  <Color x:Key="AccentColor">#FF8B93FF</Color>
  <Color x:Key="Accent2Color">#FF5AC8FA</Color>
  <Color x:Key="DangerColor">#FFF06A6A</Color>
  <Color x:Key="SuccessColor">#FF34C38F</Color>
  <Color x:Key="WarningColor">#FFF5B94A</Color>
  <Color x:Key="GlowColor">#FF000000</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FF0E1030" />
  <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#29F06A6A" />
  <SolidColorBrush x:Key="LowConfidenceRowBrush" Color="#1FF5B94A" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#4D8B93FF" />
  <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FF24262D" />
  <SolidColorBrush x:Key="DropOverlayBrush" Color="#E6141519" />

  <!-- The orb's four states. -->
  <SolidColorBrush x:Key="OrbIdleBrush" Color="#FF8B93FF" />
  <SolidColorBrush x:Key="OrbActiveBrush" Color="#FF5AC8FA" />
  <SolidColorBrush x:Key="OrbApprovalBrush" Color="#FFF5B94A" />
  <SolidColorBrush x:Key="OrbErrorBrush" Color="#FFF06A6A" />

  <!-- Flat, opaque surfaces: no glass, no scanlines; the frame is a hairline. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="HudFrameBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ScanlineBrush" Color="Transparent" />
  <!-- The sweep that runs along the prompt's edge while a job is active. -->
  <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="Transparent" Offset="0" />
    <GradientStop Color="#998B93FF" Offset="0.5" />
    <GradientStop Color="Transparent" Offset="1" />
  </LinearGradientBrush>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="HeaderFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TechFont">Cascadia Mono, Consolas</FontFamily>

  <CornerRadius x:Key="WindowCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <sys:Double x:Key="ShadowOpacity">0.45</sys:Double>
  <!-- Corner brackets and the reticle frame belong to the Holo HUD legacy theme. -->
  <Visibility x:Key="HudDecorVisibility">Collapsed</Visibility>
</ResourceDictionary>
