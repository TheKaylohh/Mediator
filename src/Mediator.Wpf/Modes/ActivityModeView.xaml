<UserControl x:Class="Mediator.Wpf.Modes.ActivityModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ws="clr-namespace:Mediator.UI.Workspace;assembly=Mediator.UI"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ws:ActivityModeViewModel}">
  <!-- 6.4 Activity: the timeline, searchable, filtered by category or job, exportable without secrets. -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="0,4,0,4">
      <TextBox Style="{StaticResource FieldBox}" Padding="24,4,6,4" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search activity" />
      <TextBlock Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" Text="&#xE721;" />
    </Grid>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Padding="8,2" Command="{Binding ExportCommand}"
              ToolTip="Save the shown events as text, with secrets removed (Documents\Mediator)" AutomationProperties.Name="Export log">
        <TextBlock Text="Export" FontSize="11.5" />
      </Button>
      <ComboBox MinWidth="120" FontSize="12" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Category" HorizontalAlignment="Left" />
    </DockPanel>
    <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="8,3" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
            Visibility="{Binding HasJobFilter, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding JobFilterText}" FontSize="11.5" VerticalAlignment="Center" />
        <Button Style="{StaticResource FlatButton}" Padding="4,0" Margin="4,0,-4,0" Command="{Binding ClearJobFilterCommand}" ToolTip="Show every job" AutomationProperties.Name="Clear job filter">
          <TextBlock Style="{StaticResource Icon}" FontSize="8" Text="&#xE711;" />
        </Button>
      </StackPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0" Text="{Binding ExportText}"
               Visibility="{Binding ExportText, Converter={StaticResource EmptyToCollapsed}}" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource MutedText}" Margin="2,4" Text="Nothing matches." Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="8,5" Margin="0,0,0,3" ToolTip="{Binding Detail}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TechLabel}" Text="{Binding TimeText}" />
                    <TextBlock Text="{Binding Tool}" FontFamily="{DynamicResource TechFont}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                    <Run Text="{Binding Phase, Mode=OneWay}" /><Run Text=" · job " /><Run Text="{Binding JobId, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
