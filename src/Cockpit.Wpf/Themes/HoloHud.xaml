<!-- Holo HUD (default): an original holographic heads-up display. Deep glass, holographic cyan, electric blue, amber warnings, crimson faults, technical type.
     Every theme defines exactly the same keys (verify/tests XamlChecker enforces it); the window and styles use
     them through DynamicResource, so ThemeManager can swap this dictionary at run time. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <Color x:Key="BgColor">#E6080D14</Color>
  <Color x:Key="PanelColor">#CC0E1724</Color>
  <Color x:Key="RaisedColor">#FF132235</Color>
  <Color x:Key="BorderColor">#6600E5FF</Color>
  <Color x:Key="TextColor">#FFE6FBFF</Color>
  <Color x:Key="MutedColor">#FF7FA6B8</Color>
  <Color x:Key="AccentColor">#FF00E5FF</Color>
  <Color x:Key="Accent2Color">#FF0088FF</Color>
  <Color x:Key="DangerColor">#FFFF2A55</Color>
  <Color x:Key="SuccessColor">#FF3DFFA8</Color>
  <Color x:Key="WarningColor">#FFFFB300</Color>
  <Color x:Key="GlowColor">#FF00E5FF</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FF02121A" />
  <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#33FF2A55" />
  <SolidColorBrush x:Key="LowConfidenceRowBrush" Color="#26FFB300" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#4400E5FF" />
  <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1A00E5FF" />
  <SolidColorBrush x:Key="DropOverlayBrush" Color="#CC04121C" />

  <!-- The orb's four states. -->
  <SolidColorBrush x:Key="OrbIdleBrush" Color="#FF00E5FF" />
  <SolidColorBrush x:Key="OrbActiveBrush" Color="#FF0088FF" />
  <SolidColorBrush x:Key="OrbApprovalBrush" Color="#FFFFB300" />
  <SolidColorBrush x:Key="OrbErrorBrush" Color="#FFFF2A55" />

  <!-- Glass: slightly lighter at the top, like a lit visor. -->
  <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EB0B1520" Offset="0" />
    <GradientStop Color="{StaticResource BgColor}" Offset="0.35" />
    <GradientStop Color="{StaticResource BgColor}" Offset="1" />
  </LinearGradientBrush>
  <!-- Window edge: a cyan-to-blue holographic rim. -->
  <LinearGradientBrush x:Key="HudFrameBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
    <GradientStop Color="#3300E5FF" Offset="0.45" />
    <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
  </LinearGradientBrush>
  <!-- Scanlines: a 1 px line every 3 px at low opacity, tiled; drawn once by the GPU, never animated. -->
  <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute" Opacity="0.07">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource AccentBrush}">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,0,4,1" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <!-- The sweep that runs along the prompt's edge while a job is active. -->
  <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="Transparent" Offset="0" />
    <GradientStop Color="#CC00E5FF" Offset="0.5" />
    <GradientStop Color="Transparent" Offset="1" />
  </LinearGradientBrush>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="HeaderFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TechFont">Cascadia Mono, Consolas</FontFamily>

  <CornerRadius x:Key="WindowCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">3</CornerRadius>
  <sys:Double x:Key="ShadowOpacity">0.55</sys:Double>
  <!-- Corner brackets and the reticle frame: shown by the HUD theme only. -->
  <Visibility x:Key="HudDecorVisibility">Visible</Visibility>
</ResourceDictionary>
