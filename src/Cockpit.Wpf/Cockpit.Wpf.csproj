<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The overlay: a thin WPF view over Cockpit.UI's ViewModels. Windows only.
    Verify builds (Linux, no WindowsDesktop reference pack) compile every .cs file here against a WPF stand-in (see
    below); the XAML is checked by the test suite (well-formed, every {Binding} resolves on the ViewModel types, every
    StaticResource exists, every pack URI resolves).
  -->
  <PropertyGroup Condition="'$(CockpitVerify)' != 'true'">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (tray) comes from Windows Forms; its global usings are removed so WPF types never become ambiguous. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AiCockpit</AssemblyName>
    <RootNamespace>Cockpit.Wpf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- LibraryImport (RegisterHotKey) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(CockpitVerify)' != 'true'">
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../Cockpit.UI/Cockpit.UI.csproj" />
    <ProjectReference Include="../Cockpit.Core/Cockpit.Core.csproj" />
  </ItemGroup>

  <!--
    V8: the theme dictionaries are compiled into AiCockpit.exe (Page items, loaded by pack URI) AND copied loose to
    <output>\Themes\ for ThemeManager's fallback. Both copies come from the same files, so they cannot drift.
  -->
  <ItemGroup Condition="'$(CockpitVerify)' != 'true'">
    <CockpitLooseTheme Include="$(MSBuildProjectDirectory)\Themes\*.xaml" />
  </ItemGroup>
  <Target Name="CockpitCopyLooseThemes" AfterTargets="Build" Condition="'$(CockpitVerify)' != 'true'">
    <Copy SourceFiles="@(CockpitLooseTheme)" DestinationFolder="$(OutDir)Themes" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CockpitPublishLooseThemes" AfterTargets="Publish" Condition="'$(CockpitVerify)' != 'true'">
    <Copy SourceFiles="@(CockpitLooseTheme)" DestinationFolder="$(PublishDir)Themes" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Verify builds (V9): EVERY .cs file of the overlay is compiled by csc, against Cockpit.UI, Cockpit.Core and
    verify/stubs/WpfCompileStub (a compile-only stand-in for WPF / Windows Forms, since the WindowsDesktop reference
    pack does not exist on Linux). XamlPartials.targets generates the InitializeComponent()/named-field partials the
    markup compiler would. The output is AiCockpit.dll (a library: there is no window to show), with warnings as errors
    like every verify build. Implicit usings mirror a WPF project: no System.IO or System.Net.Http (WPF removes them,
    because System.IO.Path would clash with System.Windows.Shapes.Path), so a file that forgets `using System.IO;`
    fails here too.
  -->
  <PropertyGroup Condition="'$(CockpitVerify)' == 'true'">
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AiCockpit</AssemblyName>
    <RootNamespace>Cockpit.Wpf</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup Condition="'$(CockpitVerify)' == 'true'">
    <Using Remove="System.IO" />
    <Using Remove="System.Net.Http" />
    <ProjectReference Include="../Cockpit.UI/Cockpit.UI.csproj" />
    <ProjectReference Include="../Cockpit.Core/Cockpit.Core.csproj" />
    <ProjectReference Include="$(CockpitRoot)verify/stubs/WpfCompileStub/WpfCompileStub.csproj" />
    <CockpitXamlPage Include="**/*.xaml" Exclude="bin/**;obj/**" />
  </ItemGroup>
  <Import Project="$(CockpitRoot)verify/stubs/WpfCompileStub/XamlPartials.targets" Condition="'$(CockpitVerify)' == 'true'" />
  <ItemGroup>
    <InternalsVisibleTo Include="Cockpit.Tests" />
  </ItemGroup>
</Project>
