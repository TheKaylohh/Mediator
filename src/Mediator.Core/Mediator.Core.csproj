<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 (not net8.0-windows) so the bus, gate and journal tests run on any OS.
         Windows-only code paths are guarded with OperatingSystem.IsWindows(). -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mediator.Core</RootNamespace>
    <!-- LibraryImport source-generated P/Invoke marshalling needs unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MediatorUsesSqlite>true</MediatorUsesSqlite>
    <MediatorUsesHashing>true</MediatorUsesHashing>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests force the non-openat2 fallback to prove it also fails closed. -->
    <InternalsVisibleTo Include="Mediator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mediator.Protocol/Mediator.Protocol.csproj" />
  </ItemGroup>
</Project>
