<Project Sdk="Microsoft.NET.Sdk">
  <!-- V18 connector: Siemens NX (NX Open Python journals). Built on its own and shipped in <app>\connectors\NX (see docs/v18/CONNECTORS.md). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mediator.Connectors.NX</RootNamespace>
    <AssemblyName>Mediator.Connector.NX</AssemblyName>
    <MediatorConnector>true</MediatorConnector>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The automation script, embedded; a copy in <data>\connectors\<id> overrides it without a rebuild. -->
    <EmbeddedResource Include="Scripts\*.py;Scripts\*.ps1" LogicalName="Mediator.Cad.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
