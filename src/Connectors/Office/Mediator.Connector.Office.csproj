<Project Sdk="Microsoft.NET.Sdk">
  <!-- V18 connector: Word, Excel, PowerPoint files and classic Outlook. Built on its own and shipped in <app>\connectors\Office (see docs/v18/CONNECTORS.md). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mediator.Connectors.Office</RootNamespace>
    <AssemblyName>Mediator.Connector.Office</AssemblyName>
    <MediatorConnector>true</MediatorConnector>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
</Project>
