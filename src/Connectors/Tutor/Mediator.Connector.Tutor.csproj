<Project Sdk="Microsoft.NET.Sdk">
  <!-- V18 connector: tutoring from PDFs with exact matrix checks. Built on its own and shipped in <app>\connectors\Tutor (see docs/v18/CONNECTORS.md). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mediator.Connectors.Tutor</RootNamespace>
    <AssemblyName>Mediator.Connector.Tutor</AssemblyName>
    <MediatorConnector>true</MediatorConnector>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
</Project>
