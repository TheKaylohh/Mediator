<Project Sdk="Microsoft.NET.Sdk">
  <!-- V18 connector: CAD files without a CAD program (STL/OBJ/PLY/3MF, STEP, IGES, DXF/SVG). Built on its own and shipped in <app>\connectors\CadFiles (see docs/v18/CONNECTORS.md). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mediator.Connectors.CadFiles</RootNamespace>
    <AssemblyName>Mediator.Connector.CadFiles</AssemblyName>
    <MediatorConnector>true</MediatorConnector>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
</Project>
