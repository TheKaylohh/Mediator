<Project>
  <!--
    VERIFY ONLY (V9). Generates, for every XAML file with an x:Class, the partial class that WPF's markup compiler
    (PresentationBuildTasks, MarkupCompilePass1) would generate: the base class from the root element, the
    IComponentConnector interface, InitializeComponent(), Connect(), and one field per x:Name / Name element in the
    root name scope (elements inside templates and styles get no field, as in WPF), typed by the element and using
    x:FieldModifier (default internal). An application root also gets the generated static Main().

    So the code-behind compiles against exactly what the real build would give it: a renamed or retyped element, a
    second base class, or a hand-written Main fails here as it would on Windows. Element types must be known to
    WpfCompileStub (an unknown one is a build error that names it).
  -->
  <UsingTask TaskName="CockpitGenerateXamlPartials" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <XamlFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        XNamespace presentation = "http://schemas.microsoft.com/winfx/2006/xaml/presentation";
        XNamespace x = "http://schemas.microsoft.com/winfx/2006/xaml";
        var types = new Dictionary<string, string>
        {
            ["Window"] = "System.Windows.Window", ["Application"] = "System.Windows.Application",
            ["UserControl"] = "System.Windows.Controls.UserControl", ["TextBox"] = "System.Windows.Controls.TextBox",
            ["TextBlock"] = "System.Windows.Controls.TextBlock", ["Border"] = "System.Windows.Controls.Border",
            ["Grid"] = "System.Windows.Controls.Grid", ["StackPanel"] = "System.Windows.Controls.StackPanel",
            ["Canvas"] = "System.Windows.Controls.Canvas", ["ToggleButton"] = "System.Windows.Controls.Primitives.ToggleButton",
            ["Ellipse"] = "System.Windows.Shapes.Ellipse", ["Rectangle"] = "System.Windows.Shapes.Rectangle", ["Path"] = "System.Windows.Shapes.Path",
            ["RotateTransform"] = "System.Windows.Media.RotateTransform", ["ScaleTransform"] = "System.Windows.Media.ScaleTransform",
            ["TranslateTransform"] = "System.Windows.Media.TranslateTransform",
        };
        // Name scopes WPF does not turn into fields: templates and styles have their own scope; resources use x:Key.
        var ownScope = new HashSet<string> { "ControlTemplate", "DataTemplate", "ItemsPanelTemplate", "HierarchicalDataTemplate", "Style", "ResourceDictionary" };

        string TypeOf(XElement e, string file)
        {
            string ns = e.Name.NamespaceName;
            if (ns.StartsWith("clr-namespace:", StringComparison.Ordinal))
                return ns.Substring("clr-namespace:".Length).Split(';')[0] + "." + e.Name.LocalName;
            if (e.Name.Namespace == presentation && types.TryGetValue(e.Name.LocalName, out var t)) return t;
            Log.LogError($"{file}: named element <{e.Name.LocalName}> has no type in WpfCompileStub's XAML map (verify/stubs/WpfCompileStub/XamlPartials.targets); add it there and to the stub.");
            return "object";
        }

        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated> by verify/stubs/WpfCompileStub/XamlPartials.targets, as WPF's markup compiler would. Do not edit. </auto-generated>");
        sb.AppendLine("#nullable disable");
        foreach (var item in XamlFiles)
        {
            string file = item.ItemSpec;
            XDocument doc;
            try { doc = XDocument.Load(file); }
            catch (Exception ex) { Log.LogError($"{file}: {ex.Message}"); continue; }
            var root = doc.Root;
            string cls = (string)root.Attribute(x + "Class");
            if (cls == null) continue;
            int dot = cls.LastIndexOf('.');
            string ns = dot < 0 ? null : cls.Substring(0, dot), name = cls.Substring(dot + 1);
            string classModifier = (string)root.Attribute(x + "ClassModifier") ?? "public";
            string baseType = TypeOf(root, file);
            bool isApp = root.Name.LocalName == "Application";

            var fields = new List<(string Type, string Name, string Modifier)>();
            void Walk(XElement e)
            {
                foreach (var child in e.Elements())
                {
                    if (ownScope.Contains(child.Name.LocalName) || child.Name.LocalName.EndsWith(".Resources", StringComparison.Ordinal)) continue;
                    string n = (string)child.Attribute(x + "Name") ?? (child.Name.LocalName.Contains(".") ? null : (string)child.Attribute("Name"));
                    if (n != null && !n.StartsWith("{", StringComparison.Ordinal))
                        fields.Add((TypeOf(child, file), n, (string)child.Attribute(x + "FieldModifier") ?? "internal"));
                    Walk(child);
                }
            }
            if ((string)root.Attribute(x + "Name") is string rootName) fields.Add((cls, rootName, (string)root.Attribute(x + "FieldModifier") ?? "internal"));
            Walk(root);

            if (ns != null) sb.AppendLine($"namespace {ns}").AppendLine("{");
            sb.AppendLine($"    {classModifier} partial class {name} : {baseType}" + (isApp ? "" : ", System.Windows.Markup.IComponentConnector"));
            sb.AppendLine("    {");
            foreach (var f in fields) sb.AppendLine($"        {f.Modifier} {f.Type} {f.Name};");
            sb.AppendLine("        private bool _contentLoaded;");
            sb.AppendLine("        public void InitializeComponent() { if (_contentLoaded) return; _contentLoaded = true; }");
            if (isApp)
            {
                sb.AppendLine("        [System.STAThreadAttribute()]");
                sb.AppendLine($"        public static void Main() {{ {cls} app = new {cls}(); app.InitializeComponent(); app.Run(); }}");
            }
            else
            {
                sb.AppendLine("        void System.Windows.Markup.IComponentConnector.Connect(int connectionId, object target)");
                sb.AppendLine("        {");
                sb.AppendLine("            switch (connectionId)");
                sb.AppendLine("            {");
                for (int i = 0; i < fields.Count; i++)
                    sb.AppendLine($"                case {i + 1}: this.{fields[i].Name} = ({fields[i].Type})target; return;");
                sb.AppendLine("            }");
                sb.AppendLine("            this._contentLoaded = true;");
                sb.AppendLine("        }");
            }
            sb.AppendLine("    }");
            if (ns != null) sb.AppendLine("}");
        }
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        string text = sb.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text) File.WriteAllText(OutputFile, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CockpitXamlPartials" BeforeTargets="CoreCompile" Inputs="@(CockpitXamlPage);$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)CockpitXaml.g.cs">
    <CockpitGenerateXamlPartials XamlFiles="@(CockpitXamlPage)" OutputFile="$(IntermediateOutputPath)CockpitXaml.g.cs" />
  </Target>
  <!-- Added at evaluation time so incremental builds (when the target is skipped) still compile it. -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)CockpitXaml.g.cs" />
  </ItemGroup>
</Project>
