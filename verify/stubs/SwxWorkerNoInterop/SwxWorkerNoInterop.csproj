<Project Sdk="Microsoft.NET.Sdk">
  <!-- VERIFY ONLY (V8). mediator-swx-worker's own sources built the way a machine without SolidWorks builds them:
       no interop assemblies at all, so Directory.Build.targets defines SOLIDWORKS_NOT_INSTALLED. Proves that the
       worker compiles without SolidWorks and that it answers "SolidWorks assemblies not installed on this machine"
       (test "swx V8: worker built without the SolidWorks interop"). A separate project, so its obj/ never mixes
       with the normal worker's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>mediator-swx-worker-nointerop</AssemblyName>
    <RootNamespace>Mediator.SwxWorker</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <MediatorUsesSolidWorks>true</MediatorUsesSolidWorks>
    <MediatorSimulateNoSolidWorks>true</MediatorSimulateNoSolidWorks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MediatorRoot)src/Connectors/SolidWorks/Worker/*.cs" />
    <!-- V18: the worker belongs to the SolidWorks connector and needs only the stdio framing from the core protocol, compiled in:
         one project reference (more breaks MEDIATOR001's warning-not-error under -warnaserror on parallel MSBuild nodes). -->
    <Compile Include="$(MediatorRoot)src/Mediator.Protocol/StdioJsonLines.cs" Link="Shared/StdioJsonLines.cs" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/SolidWorks/Contracts/Mediator.Connector.SolidWorks.Contracts.csproj" />
  </ItemGroup>
</Project>
