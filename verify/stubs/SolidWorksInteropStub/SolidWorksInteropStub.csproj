<Project Sdk="Microsoft.NET.Sdk">
  <!-- VERIFY ONLY. Compile-time stand-in for SolidWorks.Interop.sldworks and SolidWorks.Interop.swconst.
       It declares only the members Mediator.SwxWorker uses, written from the SolidWorks API documentation.
       Compiling against it proves the worker is internally consistent, NOT that every member name and
       signature matches your SolidWorks version. A ship build against your real interop assemblies is
       the real check (see SPEC.md, "SolidWorks API surface to verify"). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SolidWorks.Interop.VerifyStub</AssemblyName>
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1715;CA1720;CA1027;CA1008;CA1028</NoWarn>
  </PropertyGroup>
</Project>
