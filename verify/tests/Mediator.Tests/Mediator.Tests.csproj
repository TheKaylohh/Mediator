<Project Sdk="Microsoft.NET.Sdk">
  <!-- Self-contained test runner (no xUnit: NuGet is unavailable in the verify environment).
       Run with MediatorVerify=true, passing the paths to mediator-mcp-bridge.dll and mediator-cli.dll (see verify/run-tests.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- CA1416: the tests deliberately call the Windows-only worker against a fake SolidWorks on Linux. -->
    <MediatorIsVerifySuite>true</MediatorIsVerifySuite>
    <NoWarn>$(NoWarn);CA1303;CA1031;CA1307;CA1305;CA2007;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MediatorRoot)src/Mediator.Core/Mediator.Core.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Mediator.Protocol/Mediator.Protocol.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Mediator.SwxWorker/Mediator.SwxWorker.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Mediator.UI/Mediator.UI.csproj" />
    <!-- V8: in verify builds this is only the Win32 placement code (MonitorPlacement.cs), tested in PlacementTests. -->
    <ProjectReference Include="$(MediatorRoot)src/Mediator.Wpf/Mediator.Wpf.csproj" />
  </ItemGroup>
</Project>
