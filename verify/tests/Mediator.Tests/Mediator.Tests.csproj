<Project Sdk="Microsoft.NET.Sdk">
  <!-- Self-contained test runner (no xUnit: NuGet is unavailable in the verify environment).
       Run with MediatorVerify=true, passing the paths to mediator-mcp-bridge.dll and mediator-cli.dll (see verify/run-tests.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- CA1416: the tests deliberately call the Windows-only worker against a fake SolidWorks on Linux. -->
    <MediatorIsVerifySuite>true</MediatorIsVerifySuite>
    <NoWarn>$(NoWarn);CA1303;CA1031;CA1307;CA1305;CA2007;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MediatorRoot)src/Mediator.Core/Mediator.Core.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Mediator.Protocol/Mediator.Protocol.csproj" />
    <!-- Under an alias: the worker compiles in a copy of the stdio framing (Mediator.Protocol types). -->
    <ProjectReference Include="$(MediatorRoot)src/Connectors/SolidWorks/Worker/Mediator.SwxWorker.csproj" Aliases="worker" />
    <!-- V18: the suite tests every connector directly (the app loads them from its connectors folder). -->
    <ProjectReference Include="$(MediatorRoot)src/Connectors/SolidWorks/Mediator.Connector.SolidWorks.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/FreeCAD/Mediator.Connector.FreeCAD.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/AutoCAD/Mediator.Connector.AutoCAD.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/Inventor/Mediator.Connector.Inventor.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/NX/Mediator.Connector.NX.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/Creo/Mediator.Connector.Creo.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/CATIA/Mediator.Connector.CATIA.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/CadFiles/Mediator.Connector.CadFiles.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/PartsFromCode/Mediator.Connector.PartsFromCode.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/Office/Mediator.Connector.Office.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/Resolve/Mediator.Connector.Resolve.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/Blender/Mediator.Connector.Blender.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Connectors/Tutor/Mediator.Connector.Tutor.csproj" />
    <ProjectReference Include="$(MediatorRoot)src/Mediator.UI/Mediator.UI.csproj" />
    <!-- V8: in verify builds this is only the Win32 placement code (MonitorPlacement.cs), tested in PlacementTests. -->
    <ProjectReference Include="$(MediatorRoot)src/Mediator.Wpf/Mediator.Wpf.csproj" />
  </ItemGroup>
</Project>
