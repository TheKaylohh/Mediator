{
  "manifest_version": 3,
  "name": "Mediator for Chrome",
  "version": "1.1.0",
  "description": "Lets the Mediator desktop app on this PC read and operate your tabs when you ask it to. Talks only to Mediator on 127.0.0.1.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mediator: open the chat panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
